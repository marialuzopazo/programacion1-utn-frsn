#include <iostream>
using namespace std;

const int TAM = 3;

// Función para validar un número dentro de un rango
int validarRango(string mensaje, int min, int max) {
    int valor;
    do {
        cout << mensaje;
        cin >> valor;
        if (valor < min || valor > max) {
            cout << "Valor inválido. Debe estar entre " << min << " y " << max << "." << endl;
        }
    } while (valor < min || valor > max);
    return valor;
}

// Función para cargar precios de lombrices
void cargarPrecios(float precios[], int cantidad) {
    for (int i = 0; i < cantidad; i++) {
        cout << "Ingrese el precio para el tipo de lombriz " << (i + 1) << ": $";
        cin >> precios[i];
    }
}

// Función para cargar la granja (matriz 3x3)
void cargarGranja(int granja[TAM][TAM]) {
    for (int i = 0; i < TAM; i++) {
        for (int j = 0; j < TAM; j++) {
            cout << "Ingrese la cantidad de lombrices en la celda [" << i << "][" << j << "]: ";
            cin >> granja[i][j];
        }
    }
}

// Función para mostrar la granja
void mostrarGranja(int granja[TAM][TAM]) {
    cout << "\nMatriz de la granja:\n";
    for (int i = 0; i < TAM; i++) {
        for (int j = 0; j < TAM; j++) {
            cout << granja[i][j] << "\t";
        }
        cout << endl;
    }
}

// Función para sumar horizontal y vertical desde la celda de referencia
int sumaMaxima(int granja[TAM][TAM], int fila, int col) {
    int sumaH = 0;
    int sumaV = 0;
    for (int i = 0; i < TAM; i++) {
        sumaH += granja[fila][i]; // Suma horizontal
        sumaV += granja[i][col]; // Suma vertical
    }
    return (sumaH > sumaV) ? sumaH : sumaV;
}

int main() {
    float precios[6] = {0}; // array de precios
    int granja[TAM][TAM];
    int opcion;

    do {
        cout << "\n===== MENÚ =====" << endl;
        cout << "1. Cargar precios de lombrices" << endl;
        cout << "2. Análisis de granja" << endl;
        cout << "3. Salir" << endl;
        cout << "Seleccione una opción: ";
        cin >> opcion;

        switch (opcion) {
            case 1:
                cargarPrecios(precios, 6);
                break;

            case 2: {
                int tipo = validarRango("Ingrese el tipo de lombriz (1 a 6): ", 1, 6);
                cargarGranja(granja);
                mostrarGranja(granja);

                int fila = validarRango("Ingrese la fila de referencia (0 a 2): ", 0, 2);
                int col = validarRango("Ingrese la columna de referencia (0 a 2): ", 0, 2);

                int maxLombrices = sumaMaxima(granja, fila, col);
                float importe = maxLombrices * precios[tipo - 1];

                cout << "\nMáximo de lombrices cosechadas: " << maxLombrices << endl;
                cout << "Importe a pagar ($" << precios[tipo - 1] << " x " << maxLombrices << "): $"
                     << importe << endl;
                break;
            }

            case 3:
                cout << "Saliendo del programa. ¡Hasta luego!" << endl;
                break;

            default:
                cout << "Opción inválida. Intente nuevamente." << endl;
        }
    } while (opcion != 3);

    return 0;
}
